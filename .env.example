# Telegram API (from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Session String (generate using session_gen.py)
SESSION_STRING=your_session_string_here

# Owner Telegram User ID (your own ID)
OWNER_ID=123456789

# Groq API Key (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: AI System Prompt (leave empty for default)
AI_SYSTEM_PROMPT=

# Auto reply settings
AUTO_REPLY_ENABLED=true
ONLY_PRIVATE=true
REPLY_DELAY_MIN=1
REPLY_DELAY_MAX=3

# Memory settings (how many past messages to keep per user)
MEMORY_LIMIT=10